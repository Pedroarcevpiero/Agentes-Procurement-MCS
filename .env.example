# Copia este archivo a .env y ajusta los valores para desarrollo local.

# Base de datos (data spine)
DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement

# Claude Agent SDK / Anthropic (opcional para levantar el esqueleto y generar
# datos sinteticos; requerida solo para invocar agentes reales)
ANTHROPIC_API_KEY=

# Observabilidad (OpenTelemetry -> Arize Phoenix)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PHOENIX_UI_URL=http://localhost:6006
OTEL_SERVICE_NAME=procurement-agents

# Umbrales de negocio por defecto (guardrails)
DEFAULT_CONFIDENCE_THRESHOLD=0.7
DEFAULT_SAVINGS_LIMIT_USD=250000

# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO
